{
  "manifest_version": 3,
  "name": "吉客云 BSCM 登录态助手",
  "version": "0.1.0",
  "description": "自动捕获指定的吉客云和 BSCM 请求，并发送到本机采集助手。",
  "key": "",
  "permissions": ["debugger", "tabs", "storage"],
  "host_permissions": [
    "https://web.jackyun.com/*",
    "https://bscm.jinritemai.com/*",
    "http://127.0.0.1:18765/*"
  ],
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "登录态监听：点击开启/停止",
    "default_popup": "popup.html"
  }
}
